__pycache__/
*.py[cod]

# Tests, tooling and anything else the deployed app does not need. Delete this
# line to commit them as well.
byproduct/

# Local editor / agent tooling, not part of the app.
.claude/

# Generated exports.
*_dashboard_*.pdf
*_dashboard_*.md

.venv/
venv/
.env

# Streamlit's own secrets file. config.toml is tracked because it is only
# theming; secrets.toml holds API tokens and must never reach a public repo.
# Listed before any such file exists, since the point is that the first one
# created is already ignored rather than committed by default.
.streamlit/secrets.toml
